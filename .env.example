# Django API base URL (no trailing slash). Default local Django often runs on port 3030.
VITE_URL=http://127.0.0.1:3030/

# Livescore Admin URL for OBS overlay links (no trailing slash). Default local runs on port 3000.
VITE_LIVESCORE_ADMIN_URL=http://localhost:3000

# Vite dev server runs on port 5173 (see vite.config.ts) to avoid conflicting with Django.
