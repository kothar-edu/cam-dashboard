# Django API base URL (no trailing slash)
VITE_URL=http://127.0.0.1:8000

# Livescore Admin URL for OBS overlay links (no trailing slash). Default local runs on port 3000.
VITE_LIVESCORE_ADMIN_URL=http://localhost:3000

# Product name shown throughout the dashboard UI and the browser tab title.
VITE_APP_NAME=Crixo
